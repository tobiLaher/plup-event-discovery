# Client (Expo app) configuration. Copy to .env.local (git-ignored) and fill in.
#
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone who installs it.
# Put ONLY public values here: the project URL and the publishable (anon) key.
# NEVER put a service-role/secret key, a Gemini key or an Anthropic key in any EXPO_PUBLIC_* variable.
# Server-side keys for the ingestion service are listed in ingestion/.env.example.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
